{
  "_help": [
    "Map tileset art. mem/tileset.mem is GENERATED from this file + the sheet PNG.  Rebuild: python scripts/build_tileset_mem.py",
    "Game: 3 floors x 16 tile ids, 32x32 each. Sheet cells are 16x16 and are scaled exactly 2x (nearest neighbour, no smoothing).",
    "cell = [row, col] of the sheet, both counted from 0.  base = tile id (same floor) drawn first, so see-through pixels show floor.",
    "Anything not listed, skipped, outside the sheet or fully transparent falls back to the old art in mem/tileset_v1.mem.",
    "Keys starting with _ are comments."
  ],
  "alpha_threshold": 128,
  "fallback_mem": "mem/tileset_v1.mem",
  "output_mem": "mem/tileset.mem",
  "sheet": "my_asset/tileset/Dungeon_Tileset.png",
  "cell": 16,
  "scale": 2,
  "floors": {
    "1": { "enabled": true, "recolor": "rgb", "gain": 1.7 },
    "2": { "enabled": true, "recolor": "gbr", "gain": 1.7 },
    "3": { "enabled": true, "recolor": "brg", "gain": 1.7 }
  },
  "tile_names": {
    "0": "wall", "1": "floor", "2": "door (closed)", "3": "boss door (locked)", "4": "exit (closed)",
    "5": "hole", "6": "fence", "7": "pressure plate", "8": "door (open)", "9": "boss door (open)",
    "10": "exit (open)", "11": "plate with box", "12": "Simon plate 1", "13": "Simon plate 2",
    "14": "Simon plate 3", "15": "Simon plate 4"
  },
  "tiles": {
    "0":  { "cell": [0, 2] },
    "1":  { "cell": [2, 3] },
    "2":  { "cell": [3, 6], "base": 1 },
    "3":  { "cell": [3, 7], "base": 1 },
    "4":  { "cell": [4, 9], "base": 1 },
    "5":  { "cell": [7, 8] },
    "6":  { "cell": [4, 7], "base": 1 },
    "7":  { "cell": [6, 9], "base": 1 },
    "8":  { "cell": [6, 6], "base": 1 },
    "9":  { "cell": [6, 7], "base": 1 },
    "10": { "cell": [3, 9], "base": 1 },
    "11": { "cell": [3, 8], "base": 7 },
    "12": { "cell": [8, 9], "base": 1, "recolor": "rgb", "gain": 1.0 },
    "13": { "cell": [8, 7], "base": 1, "recolor": "rgb", "gain": 1.0 },
    "14": { "cell": [8, 6], "base": 1, "recolor": "rgb", "gain": 1.0 },
    "15": { "cell": [8, 8], "base": 1, "recolor": "rgb", "gain": 1.0 }
  },
  "overrides": {
    "_decor": "tile ids 12-15 are decoration (crack, bones, skull, rubble) on floors 1 and 2; floor 3 keeps them as the Simon plates",
    "f1.t12": { "cell": [0, 7] },
    "f1.t13": { "cell": [6, 8], "base": 1 },
    "f1.t14": { "cell": [7, 7], "base": 1 },
    "f1.t15": { "cell": [5, 9], "base": 1 },
    "f2.t12": { "cell": [0, 7] },
    "f2.t13": { "cell": [6, 8], "base": 1 },
    "f2.t14": { "cell": [7, 7], "base": 1 },
    "f2.t15": { "cell": [5, 9], "base": 1 },
    "_example_1": "\"f2.t5\": { \"cell\": [7, 8] }   floor 2, tile 5 uses another cell (f1..f3, t0..t15)",
    "_example_2": "\"f3.t0\": { \"skip\": true }     floor 3, tile 0 uses the old art"
  }
}
